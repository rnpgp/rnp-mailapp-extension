---
import '../styles/global.css';

// Secret easter-egg page — reached by pressing `g` then `k` anywhere on the
// site ("generate key", vim-style). Deliberately not linked from any nav.
---

<html lang="en" class="landing-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A brand-new key* — RNP</title>
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="You found the secret key page. The key is not real — the fun is."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="/js/site.js" defer></script>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <a href="#main" class="skip-link btn btn-primary">Skip to content</a>

    <section class="hero-band min-h-screen">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <main id="main" class="relative mx-auto max-w-3xl px-6 py-20 sm:py-24">
        <p class="mono-label !text-white/60">§ 42 — Secret level unlocked</p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">
          You pressed <span class="text-[#7db9f8]">g</span> then <span class="text-[#7db9f8]">k</span>.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/75">
          “Generate key”. Someone knows their shortcuts. Here is your freshly
          minted, 100% browser-certified OpenPGP key:
        </p>

        <!-- Fake terminal: key generation animation -->
        <div class="window mt-10 text-left">
          <div class="window-titlebar">
            <span class="flex gap-2">
              <span class="tl-dot tl-red"></span>
              <span class="tl-dot tl-gold"></span>
              <span class="tl-dot tl-green"></span>
            </span>
            <span class="font-mono text-xs text-faint">zsh — totally-real-keygen</span>
          </div>
          <div class="p-5 font-mono text-sm leading-relaxed" style="background: var(--code-bg); color: #d5ddf5;">
            <pre id="term" class="whitespace-pre-wrap break-words" aria-live="polite"></pre>
            <span id="caret" class="inline-block h-4 w-2 translate-y-0.5 animate-pulse" style="background: #00dfb7;" aria-hidden="true"></span>
          </div>
        </div>

        <div id="key-result" class="mt-8 hidden">
          <div class="card p-6">
            <p class="mono-label">Fingerprint (authentic-ish)</p>
            <p id="fake-fpr" class="mt-3 font-mono text-sm leading-loose tracking-wider text-foreground"></p>
            <div class="mt-5 flex flex-wrap gap-2.5">
              <button id="copy-fpr" type="button" class="btn btn-primary btn-sm">Copy fingerprint</button>
              <a href="/key-management/" class="btn btn-ghost btn-sm">Generate a real key instead</a>
            </div>
            <p class="mt-5 text-sm leading-relaxed text-soft">
              <strong class="text-foreground">* Not a real key.</strong> It is just for fun — like a
              rubber chicken, but cryptographic. Nothing was generated, stored, or sent anywhere;
              these hex digits were shuffled together by <code>crypto.getRandomValues</code> and will
              never protect a single byte. For a key that actually works, use the
              <a href="/getting-started/first-launch/" class="font-medium text-brand-deep hover:underline">first-launch flow</a>
              or the <a href="/key-management/" class="font-medium text-brand-deep hover:underline">Key Manager</a>.
            </p>
          </div>
        </div>

        <p class="mt-10">
          <a href="/" class="link-arrow">
            <span class="arrow" aria-hidden="true">←</span>
            Back to the real site
          </a>
        </p>
      </main>
    </section>

    <script is:inline>
      (() => {
        const reduced =
          document.documentElement.dataset.motion === 'reduced' ||
          matchMedia('(prefers-reduced-motion: reduce)').matches;

        const LINES = [
          '$ rnp --generate-key --userid "you@example.com"',
          'generating Ed25519 primary key…',
          'collecting entropy: 0 mouse wiggles required (this is a website)',
          'signing subkey… done',
          'encryption subkey… done',
          'exporting public key… done',
          '',
          'pub   ed25519 1970-01-01 [SC] [expires: never-ish]',
        ];

        const fprEl = document.getElementById('fake-fpr');
        const termEl = document.getElementById('term');
        const caret = document.getElementById('caret');
        const result = document.getElementById('key-result');
        const copyBtn = document.getElementById('copy-fpr');

        // 40 random hex chars grouped like an OpenPGP v4 fingerprint.
        const hex = Array.from(crypto.getRandomValues(new Uint8Array(20)), (b) =>
          b.toString(16).padStart(2, '0').toUpperCase(),
        ).join('');
        const groups = hex.match(/.{1,4}/g) || [];
        const fingerprint = groups.join(' ');
        fprEl.textContent = groups.slice(0, 5).join(' ') + '\n' + groups.slice(5).join(' ');

        copyBtn?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(fingerprint);
            copyBtn.textContent = 'Copied!';
            setTimeout(() => (copyBtn.textContent = 'Copy fingerprint'), 1600);
          } catch {
            copyBtn.textContent = 'Select & copy manually';
          }
        });

        const revealResult = () => {
          result.classList.remove('hidden');
          termEl.textContent += 'uid   you@example.com — congratulations, sort of\n';
          caret?.remove();
        };

        if (reduced) {
          // Reduced motion: no typing animation, show everything at once.
          termEl.textContent = LINES.join('\n') + '\n';
          revealResult();
          return;
        }

        let line = 0;
        const typeNext = () => {
          if (line < LINES.length) {
            termEl.textContent += LINES[line] + '\n';
            line += 1;
            setTimeout(typeNext, line === 1 ? 500 : 260 + Math.random() * 380);
          } else {
            setTimeout(revealResult, 450);
          }
        };
        setTimeout(typeNext, 350);
      })();
    </script>
  </body>
</html>
