---
import '../styles/global.css';
import FingerprintTool from '../components/FingerprintTool.vue';
import KeyserverLookup from '../components/KeyserverLookup.vue';

const RELEASES_URL = 'https://github.com/rnpgp/swift-rnp/releases';
const REPO_URL = 'https://github.com/rnpgp/swift-rnp';

const features = [
  {
    title: 'Key management',
    description:
      'Generate Ed25519, RSA-3072, or ECDSA P-256 keys, import existing GnuPG keys, and inspect fingerprints — all in a native Mac app.',
    href: '/key-management/',
    icon: 'M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z',
  },
  {
    title: 'Trust verification',
    description:
      'Trust on first use with manual fingerprint verification — and encryption hard-stops if a contact’s key unexpectedly changes.',
    href: '/trust-verification/',
    icon: 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z',
  },
  {
    title: 'Keyserver support',
    description:
      'Publish your key and find correspondents’ keys over VKS, HKPS, and Web Key Directory — all HTTPS, all your choice.',
    href: '/keyserver/',
    icon: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418',
  },
  {
    title: 'Accessibility',
    description:
      'Full VoiceOver labeling throughout, with automated accessibility audits running in the UI test suite.',
    href: '/security/',
    icon: 'M12 4.5a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5ZM3.75 9.75c2.77.82 5.52 1.23 8.25 1.23s5.48-.41 8.25-1.23M12 11.25v4.5m0 0-3 5.25m3-5.25 3 5.25',
  },
  {
    title: 'Localization',
    description:
      'Speaks 11 languages: English, German, Spanish, French, Italian, Japanese, Korean, Portuguese, Russian, and Chinese (Simplified & Traditional).',
    href: '/faq/',
    icon: 'm10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802',
  },
  {
    title: 'Privacy-first',
    description:
      'No telemetry, no analytics, no crash reporting. The only network traffic is the keyserver queries you initiate.',
    href: '/security/',
    icon: 'M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88',
  },
];

const banners = [
  {
    state: 'Verified',
    color: '#0E9F6E',
    bg: 'rgba(14, 159, 110, 0.10)',
    border: 'rgba(14, 159, 110, 0.35)',
    signer: 'Alice <alice@example.com>',
    line: 'Signed — verified key',
    detail: 'Fingerprint compared and confirmed by you.',
  },
  {
    state: 'Unverified',
    color: '#E8A13A',
    bg: 'rgba(232, 161, 58, 0.10)',
    border: 'rgba(232, 161, 58, 0.35)',
    signer: 'Bob <bob@example.net>',
    line: 'Signed — key not verified',
    detail: 'Valid signature; normal for new correspondents.',
  },
  {
    state: 'Problem',
    color: '#D64545',
    bg: 'rgba(214, 69, 69, 0.10)',
    border: 'rgba(214, 69, 69, 0.35)',
    signer: 'Carol <carol@example.org>',
    line: 'Key conflict — encryption blocked',
    detail: 'A different key appeared for this address.',
  },
];

const securityPoints = [
  {
    title: 'Touch ID unlock',
    text: 'Keep the keyring passphrase behind a biometric Keychain item; every process authenticates to read it.',
  },
  {
    title: 'Keychain, never files',
    text: 'A random keyring passphrase lives in the macOS Keychain — never in preferences, UserDefaults, or logs.',
  },
  {
    title: 'App Sandbox',
    text: 'Both the app and the Mail extension run sandboxed, with only the entitlements they strictly need.',
  },
  {
    title: 'Tamper-evident trust',
    text: 'The trust database is signed with Ed25519; any tampering fails closed to “unverified”, never to trust.',
  },
];
---

<html lang="en" class="landing-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RNP — OpenPGP for Apple Mail on macOS</title>
    <meta
      name="description"
      content="RNP brings OpenPGP signing, encryption, and key management to Apple Mail on macOS. Native, sandboxed, and free of telemetry."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply the saved theme before first paint (shared with Starlight docs).
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="bg-white text-slate-800 dark:bg-[#12151F] dark:text-slate-200">
    <!-- ===================== Nav ===================== -->
    <header
      class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-md dark:border-slate-800 dark:bg-[#12151F]/80"
    >
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-6">
        <a href="/" class="flex items-center gap-2.5 font-bold text-slate-900 dark:text-white">
          <img src="/icon.png" alt="RNP logo" class="h-8 w-8 rounded-lg" width="32" height="32" />
          <span class="text-lg tracking-tight">RNP</span>
        </a>
        <nav class="ml-auto hidden items-center gap-6 text-sm font-medium md:flex">
          <a href="#features" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Features</a>
          <a href="#preview" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Preview</a>
          <a href="#demos" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Try it</a>
          <a href="/getting-started/installation/" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">User Guide</a>
          <a href={REPO_URL} class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">GitHub</a>
        </nav>
        <div class="ml-auto flex items-center gap-3 md:ml-0">
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="rounded-full border border-slate-300 p-2 text-slate-600 transition hover:border-[#1A7BEC] hover:text-[#1A7BEC] dark:border-slate-700 dark:text-slate-300 dark:hover:border-[#58A0F4] dark:hover:text-[#58A0F4]"
          >
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>
          <a
            href={RELEASES_URL}
            class="rounded-full bg-[#1A7BEC] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[#0B54B8]"
          >
            Download
          </a>
        </div>
      </div>
    </header>

    <!-- ===================== Hero ===================== -->
    <section class="relative overflow-hidden">
      <div
        class="hero-glow pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full bg-[#1A7BEC]/15 blur-3xl dark:bg-[#1A7BEC]/20"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-4xl px-6 pb-20 pt-24 text-center sm:pt-32">
        <img
          src="/icon.png"
          alt="RNP logo"
          class="reveal mx-auto h-24 w-24 rounded-[1.6rem] shadow-xl shadow-[#1A7BEC]/20"
          width="96"
          height="96"
        />
        <h1
          class="reveal mx-auto mt-8 max-w-2xl text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 dark:text-white sm:text-6xl"
        >
          OpenPGP, natively inside <span class="text-[#1A7BEC] dark:text-[#58A0F4]">Apple&nbsp;Mail</span>
        </h1>
        <p class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
          Sign, encrypt, decrypt, and verify email right inside Mail.app — with a key manager that
          stays out of your way. Sandboxed, notarized, and completely free of telemetry.
        </p>
        <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href={RELEASES_URL}
            class="rounded-full bg-[#1A7BEC] px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-[#1A7BEC]/30 transition hover:-translate-y-0.5 hover:bg-[#0B54B8]"
          >
            Download for macOS
          </a>
          <a
            href="/getting-started/installation/"
            class="rounded-full border border-slate-300 px-7 py-3.5 text-base font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-[#1A7BEC] hover:text-[#1A7BEC] dark:border-slate-700 dark:text-slate-200 dark:hover:border-[#58A0F4] dark:hover:text-[#58A0F4]"
          >
            Read the manual
          </a>
        </div>
        <p class="reveal mt-6 text-sm text-slate-500 dark:text-slate-400">
          Free &amp; open · macOS 12+ · Developer ID signed &amp; notarized
        </p>
      </div>
    </section>

    <!-- ===================== Features ===================== -->
    <section id="features" class="border-t border-slate-200/70 bg-slate-50 py-24 dark:border-slate-800 dark:bg-[#181C2A]">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Serious cryptography, friendly Mac app
          </h2>
          <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
            Built on <a href="https://github.com/rnpgp/rnp" class="font-medium text-[#1A7BEC] hover:underline dark:text-[#58A0F4]">librnp</a>,
            the open-source OpenPGP (RFC 4880) library — with the polish you expect from a native Mac citizen.
          </p>
        </div>
        <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((feature) => (
              <a
                href={feature.href}
                class="reveal group rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition-all hover:-translate-y-1 hover:border-[#1A7BEC]/50 hover:shadow-lg hover:shadow-[#1A7BEC]/10 dark:border-slate-700 dark:bg-[#1D2233]"
              >
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#1A7BEC]/10 text-[#1A7BEC] transition group-hover:bg-[#1A7BEC] group-hover:text-white dark:bg-[#58A0F4]/10 dark:text-[#58A0F4] dark:group-hover:bg-[#1A7BEC]">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={feature.icon} />
                  </svg>
                </div>
                <h3 class="mt-5 text-lg font-semibold text-slate-900 dark:text-white">{feature.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{feature.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===================== UI preview ===================== -->
    <section id="preview" class="py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Signature status at a glance
          </h2>
          <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
            Incoming signed mail is verified automatically. The banner above the message tells you
            exactly where you stand — no jargon, no guesswork.
          </p>
        </div>
        <div class="mt-14 grid gap-5 lg:grid-cols-3">
          {
            banners.map((banner) => (
              <div
                class="reveal rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-[#1D2233]"
              >
                <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400 dark:text-slate-500">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                  </svg>
                  Mail security banner
                </div>
                <div
                  class="mt-3 rounded-xl border p-4"
                  style={`background-color: ${banner.bg}; border-color: ${banner.border};`}
                >
                  <div class="flex items-center gap-2">
                    <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background-color: ${banner.color};`} />
                    <span class="text-sm font-semibold" style={`color: ${banner.color};`}>{banner.line}</span>
                  </div>
                  <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{banner.signer}</p>
                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{banner.detail}</p>
                </div>
              </div>
            ))
          }
        </div>
        <p class="reveal mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
          Styled after the real banner rendered by the extension — see
          <a href="/using-with-mail/" class="font-medium text-[#1A7BEC] hover:underline dark:text-[#58A0F4]">Using with Mail</a>
          for what each state means and what you can do about it.
        </p>
      </div>
    </section>

    <!-- ===================== Interactive demos ===================== -->
    <section id="demos" class="border-t border-slate-200/70 bg-slate-50 py-24 dark:border-slate-800 dark:bg-[#181C2A]">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Try the tools, right here
          </h2>
          <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
            Two small pieces of RNP, running in your browser. Nothing leaves this page.
          </p>
        </div>
        <div class="mt-14 grid gap-8 lg:grid-cols-2">
          <div class="reveal">
            <h3 class="mb-3 text-base font-semibold text-slate-900 dark:text-white">
              Check a fingerprint
            </h3>
            <FingerprintTool client:visible />
          </div>
          <div class="reveal">
            <h3 class="mb-3 text-base font-semibold text-slate-900 dark:text-white">
              Where would my key be found?
            </h3>
            <KeyserverLookup client:visible />
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== Security ===================== -->
    <section id="security" class="py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div class="reveal">
            <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
              Security that assumes the worst
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
              RNP is engineered defense-in-depth: sandboxed processes, Keychain-held passphrases,
              and a trust database that fails closed. If anything is tampered with, you lose
              convenience — never security.
            </p>
            <a
              href="/security/"
              class="mt-6 inline-flex items-center gap-1.5 font-semibold text-[#1A7BEC] transition hover:gap-2.5 dark:text-[#58A0F4]"
            >
              Read the security model
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {
              securityPoints.map((point) => (
                <div class="reveal rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-[#1D2233]">
                  <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{point.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{point.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== Download CTA ===================== -->
    <section id="download" class="border-t border-slate-200/70 bg-gradient-to-b from-[#1A7BEC]/5 to-transparent py-24 dark:border-slate-800 dark:from-[#1A7BEC]/10">
      <div class="reveal mx-auto max-w-3xl px-6 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          Take back your inbox privacy
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
          Download the signed, notarized DMG, create your key, and send your first encrypted mail
          in minutes.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href={RELEASES_URL}
            class="rounded-full bg-[#1A7BEC] px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-[#1A7BEC]/30 transition hover:-translate-y-0.5 hover:bg-[#0B54B8]"
          >
            Download the latest release
          </a>
          <a
            href="/getting-started/first-launch/"
            class="rounded-full border border-slate-300 px-7 py-3.5 text-base font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-[#1A7BEC] hover:text-[#1A7BEC] dark:border-slate-700 dark:text-slate-200 dark:hover:border-[#58A0F4] dark:hover:text-[#58A0F4]"
          >
            First-launch walkthrough
          </a>
        </div>
      </div>
    </section>

    <!-- ===================== Footer ===================== -->
    <footer class="border-t border-slate-200/70 py-12 dark:border-slate-800">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 sm:grid-cols-3">
        <div>
          <div class="flex items-center gap-2.5 font-bold text-slate-900 dark:text-white">
            <img src="/icon.png" alt="" class="h-7 w-7 rounded-md" width="28" height="28" />
            RNP
          </div>
          <p class="mt-3 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            OpenPGP signing, encryption, and key management for Apple Mail on macOS, built on
            <a href="https://github.com/rnpgp/rnp" class="text-[#1A7BEC] hover:underline dark:text-[#58A0F4]">librnp</a>.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Manual</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/getting-started/installation/" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Installation</a></li>
            <li><a href="/key-management/" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Key management</a></li>
            <li><a href="/trust-verification/" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Trust &amp; verification</a></li>
            <li><a href="/keyserver/" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Keyservers</a></li>
            <li><a href="/troubleshooting/" class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Troubleshooting</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Project</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href={REPO_URL} class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">GitHub repository</a></li>
            <li><a href={RELEASES_URL} class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Releases</a></li>
            <li><a href={`${REPO_URL}/issues`} class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Report an issue</a></li>
            <li><a href={`${REPO_URL}/blob/main/docs/SECURITY.md`} class="text-slate-600 transition hover:text-[#1A7BEC] dark:text-slate-300">Security policy</a></li>
          </ul>
        </div>
      </div>
      <p class="mx-auto mt-10 max-w-6xl px-6 text-xs text-slate-400 dark:text-slate-500">
        RNP uses librnp, Botan, and json-c (BSD-2-Clause / MIT). See the repository for licensing
        details.
      </p>
    </footer>

    <script is:inline>
      // Theme toggle — stays in sync with the Starlight docs theme.
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('starlight-theme', next);
      });

      // Scroll-reveal animations.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
