---
import '../styles/global.css';
import FingerprintTool from '../components/FingerprintTool.vue';
import KeyserverLookup from '../components/KeyserverLookup.vue';
import TrustStateDemo from '../components/TrustStateDemo.vue';

const RELEASES_URL = 'https://github.com/rnpgp/swift-rnp/releases';
const REPO_URL = 'https://github.com/rnpgp/swift-rnp';

const features = [
  {
    title: 'Key management',
    description:
      'Generate Ed25519, RSA-3072, or ECDSA P-256 keys, import existing GnuPG keys, and inspect fingerprints — all in a native Mac app.',
    href: '/key-management/',
    icon: 'M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z',
  },
  {
    title: 'Trust verification',
    description:
      'Trust on first use with manual fingerprint verification — and encryption hard-stops if a contact’s key unexpectedly changes.',
    href: '/trust-verification/',
    icon: 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z',
  },
  {
    title: 'Keyserver support',
    description:
      'Publish your key and find correspondents’ keys over VKS, HKPS, and Web Key Directory — all HTTPS, all your choice.',
    href: '/keyserver/',
    icon: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418',
  },
  {
    title: 'Accessibility',
    description:
      'Full VoiceOver labeling throughout, with automated accessibility audits running in the UI test suite.',
    href: '/security/',
    icon: 'M12 4.5a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5ZM3.75 9.75c2.77.82 5.52 1.23 8.25 1.23s5.48-.41 8.25-1.23M12 11.25v4.5m0 0-3 5.25m3-5.25 3 5.25',
  },
  {
    title: 'Localization',
    description:
      'Speaks 11 languages: English, German, Spanish, French, Italian, Japanese, Korean, Portuguese, Russian, and Chinese (Simplified & Traditional).',
    href: '/faq/',
    icon: 'm10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802',
  },
  {
    title: 'Privacy-first',
    description:
      'No telemetry, no analytics, no crash reporting. The only network traffic is the keyserver queries you initiate.',
    href: '/security/',
    icon: 'M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88',
  },
];

const banners = [
  {
    state: 'Verified',
    color: '#0E9F6E',
    bg: 'rgba(14, 159, 110, 0.10)',
    border: 'rgba(14, 159, 110, 0.35)',
    signer: 'Alice <alice@example.com>',
    line: 'Signed — verified key',
    detail: 'Fingerprint compared and confirmed by you.',
  },
  {
    state: 'Unverified',
    color: '#E8A13A',
    bg: 'rgba(232, 161, 58, 0.10)',
    border: 'rgba(232, 161, 58, 0.35)',
    signer: 'Bob <bob@example.net>',
    line: 'Signed — key not verified',
    detail: 'Valid signature; normal for new correspondents.',
  },
  {
    state: 'Problem',
    color: '#D64545',
    bg: 'rgba(214, 69, 69, 0.10)',
    border: 'rgba(214, 69, 69, 0.35)',
    signer: 'Carol <carol@example.org>',
    line: 'Key conflict — encryption blocked',
    detail: 'A different key appeared for this address.',
  },
];

const securityPoints = [
  {
    title: 'Touch ID unlock',
    text: 'Keep the keyring passphrase behind a biometric Keychain item; every process authenticates to read it.',
  },
  {
    title: 'Keychain, never files',
    text: 'A random keyring passphrase lives in the macOS Keychain — never in preferences, UserDefaults, or logs.',
  },
  {
    title: 'App Sandbox',
    text: 'Both the app and the Mail extension run sandboxed, with only the entitlements they strictly need.',
  },
  {
    title: 'Tamper-evident trust',
    text: 'The trust database is signed with Ed25519; any tampering fails closed to “unverified”, never to trust.',
  },
];

const steps = [
  {
    title: 'Download & install',
    text: 'Grab the signed, notarized DMG, drag RNP to Applications, and launch it once to register the Mail extension.',
    href: '/getting-started/installation/',
    link: 'Installation guide',
  },
  {
    title: 'Create or import a key',
    text: 'A friendly first-launch flow generates an Ed25519 key — or imports your existing GnuPG keyring.',
    href: '/getting-started/first-launch/',
    link: 'First-launch walkthrough',
  },
  {
    title: 'Enable in Mail & send',
    text: 'Flip on the extension in Mail → Settings → Extensions, then sign and encrypt right from the compose window.',
    href: '/using-with-mail/',
    link: 'Using with Mail',
  },
];
---

<html lang="en" class="landing-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RNP — OpenPGP for Apple Mail on macOS</title>
    <meta
      name="description"
      content="RNP brings OpenPGP signing, encryption, and key management to Apple Mail on macOS. Native, sandboxed, and free of telemetry."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply the saved theme before first paint (shared with Starlight docs).
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <a href="#main" class="skip-link btn btn-primary">Skip to content</a>

    <!-- ===================== Nav ===================== -->
    <header class="sticky top-0 z-50 border-b border-line bg-background/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-6">
        <a href="/" class="flex items-center gap-2.5 font-bold text-foreground" aria-label="RNP home">
          <img src="/rnp-symbol.svg" alt="" class="h-6 w-auto" width="40" height="24" />
          <span class="text-lg tracking-tight">RNP</span>
          <span class="chip-outline chip hidden sm:inline-flex">for Apple Mail</span>
        </a>
        <nav class="ml-auto hidden items-center gap-6 text-sm font-medium md:flex">
          <a href="#features" class="text-soft transition hover:text-brand">Features</a>
          <a href="#preview" class="text-soft transition hover:text-brand">Preview</a>
          <a href="#demos" class="text-soft transition hover:text-brand">Try it</a>
          <a href="/getting-started/installation/" class="text-soft transition hover:text-brand">User Guide</a>
          <a href={REPO_URL} class="text-soft transition hover:text-brand">GitHub</a>
        </nav>
        <div class="ml-auto flex items-center gap-3 md:ml-0">
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="rounded-full border border-line p-2 text-soft transition hover:border-brand hover:text-brand"
          >
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>
          <a href={RELEASES_URL} class="btn btn-primary btn-sm">Download</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- ===================== Hero ===================== -->
      <section class="hero-band">
        <div class="hero-grid" aria-hidden="true"></div>
        <img
          src="/rnp-symbol.svg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute -right-24 -top-24 h-[420px] w-auto opacity-[0.07]"
        />
        <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-6 pb-24 pt-20 lg:grid-cols-2 lg:pb-28 lg:pt-24">
          <div>
            <p class="mono-label !text-white/60">OpenPGP · Apple Mail · macOS</p>
            <h1 class="mt-5 text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-[3.4rem]">
              OpenPGP for Apple Mail,<br />
              <span class="text-[#7db9f8]">native and polished.</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">
              Sign, encrypt, decrypt, and verify email right inside Mail.app — with a key
              manager that stays out of your way. Sandboxed, notarized, and completely
              free of telemetry.
            </p>
            <div class="mt-9 flex flex-wrap items-center gap-3">
              <a href={RELEASES_URL} class="btn btn-white btn-lg">Download for macOS</a>
              <a href="/getting-started/installation/" class="btn btn-outline-white btn-lg">Read the manual</a>
            </div>
            <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-white/55">
              <span class="inline-flex items-center gap-2">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#00dfb7]"></span>
                Free &amp; open source
              </span>
              <span>macOS 12+</span>
              <span>Developer ID signed &amp; notarized</span>
            </div>
          </div>

          <!-- Hero visual: mock Mail window with verified banner -->
          <div class="reveal lg:justify-self-end">
            <div class="window w-full max-w-lg text-left">
              <div class="window-titlebar">
                <span class="flex gap-2">
                  <span class="tl-dot tl-red"></span>
                  <span class="tl-dot tl-gold"></span>
                  <span class="tl-dot tl-green"></span>
                </span>
                <span class="font-mono text-xs text-faint">Mail — Inbox</span>
                <img src="/icon.png" alt="" class="ml-auto h-5 w-5 rounded" width="20" height="20" />
              </div>
              <div class="p-5">
                <div class="flex items-baseline justify-between gap-4">
                  <p class="text-sm font-semibold text-foreground">Alice &lt;alice@example.com&gt;</p>
                  <p class="font-mono text-[0.7rem] text-faint">09:41</p>
                </div>
                <p class="mt-0.5 text-xs text-soft">Q3 report — signed &amp; encrypted</p>
                <div class="mt-4 flex items-start gap-3 rounded-xl border p-3.5" style="background-color: rgba(14, 159, 110, 0.12); border-color: rgba(14, 159, 110, 0.4);">
                  <svg class="mt-0.5 h-5 w-5 shrink-0" style="color: #0e9f6e;" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.6 7.7 9.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z" clip-rule="evenodd" />
                  </svg>
                  <div>
                    <p class="text-sm font-semibold" style="color: #0e9f6e;">Signed by alice@example.com — verified key</p>
                    <p class="mt-0.5 font-mono text-[0.7rem] text-soft">9F3B 7A2C 55E1 08D4 6C90 A3F7 12B8 4D6E C1A5 7F09</p>
                  </div>
                </div>
                <div class="mt-5 space-y-2.5" aria-hidden="true">
                  <div class="h-2.5 w-11/12 rounded-full bg-surface-dim"></div>
                  <div class="h-2.5 w-full rounded-full bg-surface-dim"></div>
                  <div class="h-2.5 w-4/5 rounded-full bg-surface-dim"></div>
                  <div class="h-2.5 w-3/5 rounded-full bg-surface-dim"></div>
                </div>
                <div class="mt-5 flex items-center gap-2">
                  <span class="chip chip-teal">Encrypted</span>
                  <span class="chip">Verified signature</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== librnp band ===================== -->
      <section class="band-gold">
        <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5">
          <p class="text-sm font-medium text-foreground">
            Built on <a href="https://github.com/rnpgp/rnp" class="font-bold text-brand-deep hover:underline">librnp</a> —
            the open-source OpenPGP engine powering end-to-end encryption in Mozilla Thunderbird.
          </p>
          <a href="https://www.rnpgp.org" class="link-arrow text-sm">
            rnpgp.org
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <!-- ===================== Features ===================== -->
      <section id="features" class="scroll-mt-20 py-20 md:py-24">
        <div class="mx-auto max-w-6xl px-6">
          <div class="reveal">
            <p class="mono-label">§ 01 — Features</p>
            <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight text-foreground md:text-4xl">
              Serious cryptography, friendly Mac app
            </h2>
            <hr class="gradient-rule mt-5 w-16" />
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-soft">
              RFC 4880 OpenPGP, done the Mac way: native UI, sandboxed processes, and the
              polish you expect from a first-class citizen of macOS.
            </p>
          </div>
          <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {
              features.map((feature) => (
                <a href={feature.href} class="reveal card card-hover group block p-6">
                  <div class="feature-icon">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={feature.icon} />
                    </svg>
                  </div>
                  <h3 class="mt-5 text-lg font-semibold text-foreground">{feature.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-soft">{feature.description}</p>
                  <span class="link-arrow mt-4 text-sm">
                    Learn more
                    <span class="arrow" aria-hidden="true">→</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ===================== UI preview ===================== -->
      <section id="preview" class="band-tint scroll-mt-20 py-20 md:py-24">
        <div class="mx-auto max-w-6xl px-6">
          <div class="reveal">
            <p class="mono-label">§ 02 — The app</p>
            <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight text-foreground md:text-4xl">
              Your keys, crystal clear
            </h2>
            <hr class="gradient-rule mt-5 w-16" />
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-soft">
              The key manager shows every key’s user ID, fingerprint, and trust state at a
              glance. In Mail, a banner above each signed message tells you exactly where
              you stand — no jargon, no guesswork.
            </p>
          </div>

          <!-- Mock: RNP key manager window -->
          <div class="reveal mt-12">
            <div class="window">
              <div class="window-titlebar">
                <span class="flex gap-2">
                  <span class="tl-dot tl-red"></span>
                  <span class="tl-dot tl-gold"></span>
                  <span class="tl-dot tl-green"></span>
                </span>
                <span class="font-mono text-xs text-faint">RNP — Key Manager</span>
              </div>
              <div class="grid sm:grid-cols-[16rem_1fr]">
                <!-- Key list -->
                <div class="border-b border-line bg-surface-dim p-3 sm:border-b-0 sm:border-r">
                  <div class="flex items-center gap-2.5 rounded-lg bg-tint-blue px-3 py-2.5">
                    <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-brand font-mono text-xs font-bold text-white">A</span>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-semibold text-foreground">Alice</p>
                      <p class="truncate font-mono text-[0.68rem] text-faint">alice@example.com</p>
                    </div>
                    <span class="chip chip-teal ml-auto !px-2">Verified</span>
                  </div>
                  <div class="mt-1.5 flex items-center gap-2.5 rounded-lg px-3 py-2.5">
                    <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-surface font-mono text-xs font-bold text-soft ring-1 ring-line">B</span>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium text-foreground">Bob</p>
                      <p class="truncate font-mono text-[0.68rem] text-faint">bob@example.net</p>
                    </div>
                  </div>
                  <div class="mt-1.5 flex items-center gap-2.5 rounded-lg px-3 py-2.5">
                    <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-surface font-mono text-xs font-bold text-soft ring-1 ring-line">C</span>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium text-foreground">Carol</p>
                      <p class="truncate font-mono text-[0.68rem] text-faint">carol@example.org</p>
                    </div>
                    <span class="chip chip-gold ml-auto !px-2">Conflict</span>
                  </div>
                </div>
                <!-- Key detail -->
                <div class="p-6">
                  <div class="flex flex-wrap items-center gap-3">
                    <h3 class="text-lg font-bold text-foreground">Alice &lt;alice@example.com&gt;</h3>
                    <span class="chip">Ed25519</span>
                    <span class="chip chip-teal">Verified</span>
                  </div>
                  <p class="mono-label mt-6">Fingerprint</p>
                  <p class="mt-2 rounded-lg border border-line bg-surface-dim p-4 font-mono text-sm leading-loose tracking-wider text-foreground">
                    9F3B 7A2C 55E1 08D4 6C90<br />A3F7 12B8 4D6E C1A5 7F09
                  </p>
                  <div class="mt-5 flex flex-wrap gap-2.5">
                    <span class="btn btn-primary btn-sm">Copy fingerprint</span>
                    <span class="btn btn-ghost btn-sm">Export public key</span>
                    <span class="btn btn-ghost btn-sm">Publish to keyserver</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Mail banner states -->
          <div class="mt-10 grid gap-5 lg:grid-cols-3">
            {
              banners.map((banner) => (
                <div class="reveal card p-5">
                  <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-faint">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                    </svg>
                    Mail security banner · {banner.state}
                  </div>
                  <div
                    class="mt-3 rounded-xl border p-4"
                    style={`background-color: ${banner.bg}; border-color: ${banner.border};`}
                  >
                    <div class="flex items-center gap-2">
                      <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background-color: ${banner.color};`} />
                      <span class="text-sm font-semibold" style={`color: ${banner.color};`}>{banner.line}</span>
                    </div>
                    <p class="mt-2 text-sm text-soft">{banner.signer}</p>
                    <p class="mt-1 text-xs text-faint">{banner.detail}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="reveal mt-6 text-sm text-faint">
            Styled after the real banner rendered by the extension — see{' '}
            <a href="/using-with-mail/" class="font-medium text-brand-deep hover:underline">Using with Mail</a>{' '}
            for what each state means and what you can do about it.
          </p>
        </div>
      </section>

      <!-- ===================== Interactive demos ===================== -->
      <section id="demos" class="scroll-mt-20 py-20 md:py-24">
        <div class="mx-auto max-w-6xl px-6">
          <div class="reveal">
            <p class="mono-label">§ 03 — Try it</p>
            <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight text-foreground md:text-4xl">
              Three small pieces of RNP, live in your browser
