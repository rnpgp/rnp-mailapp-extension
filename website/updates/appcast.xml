<?xml version="1.0" standalone="yes"?>
<!--
  Sparkle appcast feed. One <item> per release; Sparkle picks the
  highest one the user is allowed to upgrade to.

  CI auto-updates this file in .github/workflows/release.yml on each
  release: after the DMG is signed + notarized, the workflow runs
  Sparkle's `sign_update` tool against the DMG with the private key
  stored in the SPARKLE_EDDSA_PRIVATE_KEY secret, then commits the
  resulting edSignature + length back into the corresponding <item>.

  The verification key (SUPublicEDKey) lives in MailApp/MailExtensionsContainer/Info.plist.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
