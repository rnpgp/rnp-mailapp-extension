<?xml version="1.0" standalone="yes"?>
<!--
  Sparkle appcast feed. One <item> per release; Sparkle picks the
  highest one the user is allowed to upgrade to.

  This file is generated/updated by CI (.github/workflows/release.yml)
  on each release. The EdDSA signature is generated by Sparkle's
  `sign_update` tool against the published DMG.

  Until CI auto-updates this file, edit it manually after each release.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>RNP</title>
    <link>https://rnpgp.org/updates/appcast.xml</link>
    <description>Most recent changes to RNP</description>
    <language>en</language>

    <item>
      <title>Version 0.9.7</title>
      <pubDate>Wed, 06 Aug 2026 00:00:00 +0000</pubDate>
      <sparkle:version>9070</sparkle:version>
      <sparkle:shortVersionString>0.9.7</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <!--
        TODO(0.9.7): edDSA is empty because the project has not yet
        generated an Ed25519 Sparkle signing key. Steps to land in a
        follow-up "Sparkle key" PR:
          1. Generate the keypair: Sparkle's `generate_keys` tool
             (private key goes to Keychain, public key is printed).
          2. Add SUPublicEDKey=<public key> to the app's Info.plist
             so Sparkle knows what to verify against.
          3. Export the private key and store it as the GitHub secret
             SPARKLE_EDDSA_PRIVATE_KEY so CI can sign future DMGs.
          4. Re-run `sign_update RNP-0.9.7.dmg` and paste the output
             into sparkle:edDSA below.
        Until edDSA is filled in, Sparkle will refuse to auto-update
        installed clients to 0.9.7 — they must download manually.
      -->
      <description><![CDATA[
        <h2>What's new</h2>
        <ul>
          <li>CloudKit sync enabled (canonical keyring mirrors to iCloud private DB)</li>
          <li>Deprecated KeyManager removed from project code — builds clean</li>
          <li>Manual signing restored + RNPUnitTests target wired in</li>
        </ul>
      ]]></description>
      <enclosure
        url="https://github.com/rnpgp/rnp-mailapp-extension/releases/download/v0.9.7/RNP-0.9.7.dmg"
        sparkle:edDSA=""
        length="11484324"
        type="application/octet-stream" />
    </item>

