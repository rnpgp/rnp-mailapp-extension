    "rotate.encryption.message": {
      "comment": "Rotation explanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new encryption subkey will be generated and the old one retired after a 30-day grace period."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein neuer Verschlüsselungs-Unterschlüssel wird erzeugt und der alte nach einer 30-tägigen Übergangsfrist außer Dienst gestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se generará una nueva subclave de cifrado y la anterior se retirará tras un período de gracia de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une nouvelle sous-clé de chiffrement sera générée et l’ancienne sera retirée après une période de grâce de 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verrà generata una nuova sottochiave di crittografia e quella precedente verrà ritirata dopo un periodo di grazia di 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しい暗号化副鍵が生成され、古い副鍵は 30 日間の猶予期間後に廃止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 암호화 하위 키가 생성되고 기존 키는 30일 유예 기간 후에 사용 중지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma nova subchave de encriptação será gerada e a antiga será retirada após um período de tolerância de 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Будет создан новый подключ шифрования, а старый будет выведен из использования после 30-дневного льготного периода."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将生成新的加密子密钥，旧子密钥将在 30 天宽限期后停用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將產生新的加密子金鑰，舊子金鑰將在 30 天寬限期後停用。"
          }
        }
      }
    },
    "rotate.signing.message": {
      "comment": "Rotation explanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new signing subkey will be generated. Recipients should refresh your public key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein neuer Signatur-Unterschlüssel wird erzeugt. Empfänger sollten Ihren öffentlichen Schlüssel aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se generará una nueva subclave de firma. Los destinatarios deben actualizar tu clave pública."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une nouvelle sous-clé de signature sera générée. Les destinataires doivent actualiser votre clé publique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verrà generata una nuova sottochiave di firma. I destinatari devono aggiornare la tua chiave pubblica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しい署名副鍵が生成されます。受信者はあなたの公開鍵を更新する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 서명 하위 키가 생성됩니다. 수신자는 공개 키를 새로 고쳐야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma nova subchave de assinatura será gerada. Os destinatários devem atualizar a sua chave pública."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Будет создан новый подключ подписи. Получателям следует обновить ваш открытый ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将生成新的签名子密钥。收件人应刷新您的公钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將產生新的簽名子金鑰。收件人應重新整理您的公開金鑰。"
          }
        }
      }
    },
