// librnp.xcconfig
//
// Shared build settings for locating librnp from the app, extension and CLI
// targets.
//
// How librnp is found:
// - Headers and the link library come from the Swift package's CRnp
//   system-library target (Sources/CRnp/module.modulemap declares
//   `pkgConfig: "librnp"`), so pkg-config must be able to find librnp.pc.
//   pkg-config reads PKG_CONFIG_PATH from the build environment — set it
//   when invoking xcodebuild from a shell, e.g.
//       PKG_CONFIG_PATH=/usr/local/lib/pkgconfig xcodebuild ...
//   Without PKG_CONFIG_PATH, pkg-config's default search path already
//   covers both standard prefixes below (/usr/local and /opt/homebrew).
// - librnp.dylib uses an @rpath install name, so every executable that
//   links it needs runpath search paths at runtime; those are provided
//   here via LIBRNP_RUNPATH_SEARCH_PATHS.
//
// If librnp is installed in a custom prefix, override LIBRNP_PREFIX (and
// set PKG_CONFIG_PATH accordingly), e.g.
//     xcodebuild LIBRNP_PREFIX=/opt/librnp ...

LIBRNP_PREFIX = /usr/local
LIBRNP_FALLBACK_PREFIX = /opt/homebrew
LIBRNP_RUNPATH_SEARCH_PATHS = $(LIBRNP_PREFIX)/lib $(LIBRNP_FALLBACK_PREFIX)/lib
