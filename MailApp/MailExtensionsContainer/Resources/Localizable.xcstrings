          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 的金鑰已變更。加密前請驗證新指紋。"
          }
        }
      }
    },
    "banner.keyringLocked": {
      "comment": "Banner shown when the keyring is locked behind Touch ID.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your keyring is locked. Unlock it with Touch ID to sign and decrypt mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihr Schlüsselbund ist gesperrt. Entsperren Sie ihn mit Touch ID, um E-Mails zu signieren und zu entschlüsseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu llavero está bloqueado. Desbloquéalo con Touch ID para firmar y descifrar correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre trousseau est verrouillé. Déverrouillez-le avec Touch ID pour signer et déchiffrer vos courriels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo portachiavi è bloccato. Sbloccalo con Touch ID per firmare e decifrare la posta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キーリングはロックされています。メールの署名と復号のために Touch ID でロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키링이 잠겨 있습니다. Touch ID로 잠금을 해제해야 메일에 서명하고 복호화할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O seu chaveiro está bloqueado. Desbloqueie-o com o Touch ID para assinar e decifrar e-mails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Связка ключей заблокирована. Разблокируйте её с помощью Touch ID, чтобы подписывать и расшифровывать почту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您的密钥环已锁定。请使用触控 ID 解锁以签名和解密邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您的密鑰環已鎖定。請使用 Touch ID 解鎖以簽署和解密郵件。"
          }
        }
      }
    },
