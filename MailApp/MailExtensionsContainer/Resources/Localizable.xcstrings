    "detail.keepOldBinding.help": {
      "comment": "Help text for the keep-old-binding button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejects the new key and keeps encrypting to the previously recorded key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weist den neuen Schlüssel ab und verschlüsselt weiterhin an den zuvor gespeicherten Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rechaza la nueva clave y sigue cifrando con la clave registrada anteriormente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rejette la nouvelle clé et continue de chiffrer avec la clé précédemment enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rifiuta la nuova chiave e continua a cifrare con la chiave registrata in precedenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しい鍵を拒否し、以前に記録された鍵への暗号化を継続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 키를 거부하고 이전에 기록된 키로 계속 암호화합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rejeita a nova chave e continua a encriptar com a chave registada anteriormente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отклоняет новый ключ и продолжает шифровать на ранее записанный ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拒绝新密钥，继续加密到之前记录的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拒絕新金鑰，繼續加密到先前記錄的金鑰。"
          }
        }
      }
    },
