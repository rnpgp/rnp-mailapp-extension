          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A chave de %@ foi alterada. Verifique a nova impressão digital antes de encriptar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключ для %@ изменился. Проверьте новый отпечаток перед шифрованием."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
