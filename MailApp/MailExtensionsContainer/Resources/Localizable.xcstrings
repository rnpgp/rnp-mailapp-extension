        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First seen key. Compare the fingerprint with the owner before trusting it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum ersten Mal gesehen. Vergleichen Sie den Fingerabdruck mit dem Inhaber, bevor Sie ihm vertrauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clave vista por primera vez. Compara la huella con el propietario antes de confiar en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clé vue pour la première fois. Comparez l'empreinte avec le propriétaire avant de lui faire confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiave vista per la prima volta. Confronta l'impronta con il proprietario prima di fidarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "初めて見るキーです。信頼する前に所有者とフィンガープリントを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "처음 본 키입니다. 신뢰하기 전에 소유자와 지문을 대조하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chave vista pela primeira vez. Compare a impressão digital com o proprietário antes de confiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключ встречен впервые. Сверьте отпечаток с владельцем, прежде чем доверять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "首次见到的密钥。信任前请与持有者核对指纹。"
