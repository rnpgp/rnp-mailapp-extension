    "keyringUnlock.message": {
      "comment": "Explanation in the keyring unlock sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyring passphrase is protected by Touch ID. Authenticate to unlock it, or enter the passphrase you chose during setup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Schlüsselbund-Passphrase ist durch Touch ID geschützt. Authentifizieren Sie sich zum Entsperren oder geben Sie die bei der Einrichtung gewählte Passphrase ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La frase de contraseña del llavero está protegida con Touch ID. Autentícate para desbloquearla o introduce la frase de contraseña que elegiste durante la configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La phrase de passe du trousseau est protégée par Touch ID. Authentifiez-vous pour la déverrouiller, ou saisissez la phrase de passe choisie lors de la configuration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La passphrase del portachiavi è protetta da Touch ID. Autenticati per sbloccarla oppure inserisci la passphrase scelta durante la configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キーリングのパスフレーズは Touch ID で保護されています。認証してロックを解除するか、設定時に選択したパスフレーズを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키링 암호구문은 Touch ID로 보호됩니다. 인증하여 잠금을 해제하거나 설정 중에 선택한 암호구문을 입력하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A frase-passe do chaveiro está protegida pelo Touch ID. Autentique-se para a desbloquear ou introduza a frase-passe que escolheu durante a configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Парольная фраза связки ключей защищена Touch ID. Пройдите аутентификацию, чтобы разблокировать её, или введите парольную фразу, выбранную при настройке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密钥环密码短语受触控 ID 保护。请进行身份验证以解锁，或输入您在设置过程中选择的密码短语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密鑰環密碼短語受 Touch ID 保護。請進行身份驗證以解鎖，或輸入您在設定過程中選擇的密碼短語。"
          }
        }
      }
    },
