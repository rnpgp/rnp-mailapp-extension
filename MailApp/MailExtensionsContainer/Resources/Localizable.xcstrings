    "foreignPassphrase.message": {
      "comment": "Explanation shown in the foreign passphrase prompt.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This secret key is protected by its own passphrase, which is different from the keyring passphrase. Enter the key’s passphrase to use it for signing and decryption."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser geheime Schlüssel ist mit einer eigenen Passphrase geschützt, die sich von der Passphrase des Schlüsselbunds unterscheidet. Gib die Passphrase des Schlüssels ein, um ihn zum Signieren und Entschlüsseln zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta clave secreta está protegida por su propia frase de contraseña, distinta de la del llavero. Introduce la frase de contraseña de la clave para usarla al firmar y descifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette clé secrète est protégée par sa propre phrase de passe, différente de celle du trousseau. Saisissez la phrase de passe de la clé pour l’utiliser pour signer et déchiffrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa chiave segreta è protetta da una propria passphrase, diversa da quella del portachiavi. Inserisci la passphrase della chiave per usarla per firmare e decifrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この秘密鍵はキーリングのパスフレーズとは異なる独自のパスフレーズで保護されています。署名と復号に使用するには、鍵のパスフレーズを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 개인 키는 키링 암호와 다른 고유 암호로 보호되어 있습니다. 서명과 복호화에 사용하려면 키의 암호를 입력하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta chave secreta está protegida por sua própria frase-senha, diferente da frase-senha do chaveiro. Digite a frase-senha da chave para usá-la para assinar e descriptografar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот секретный ключ защищён собственной парольной фразой, отличной от парольной фразы связки ключей. Введите парольную фразу ключа, чтобы использовать его для подписи и расшифровки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此私钥由其自身的密码保护,该密码与钥匙串密码不同。请输入该密钥的密码,以便用于签名和解密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此私密金鑰由其自身的密語保護,與鑰匙圈密語不同。請輸入該金鑰的密語,以便用於簽署與解密。"
          }
        }
      }
    },
