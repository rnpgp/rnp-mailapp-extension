            "value": "Der Schlüssel für %@ hat sich geändert. Überprüfen Sie den neuen Fingerabdruck, bevor Sie verschlüsseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clave de %@ ha cambiado. Verifica la nueva huella antes de cifrar."
          }
        },
        "fr": {
          "stringUnit": {
