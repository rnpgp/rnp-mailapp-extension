    "onboarding.done.revocationHint": {
      "comment": "Hint about revocation certificate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it somewhere safe. You will need it if you ever lose access to your key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bewahren Sie es an einem sicheren Ort auf. Sie benötigen es, falls Sie den Zugriff auf Ihren Schlüssel verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guárdalo en un lugar seguro. Lo necesitarás si pierdes el acceso a tu clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conservez-le en lieu sûr. Vous en aurez besoin si vous perdez l’accès à votre clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conservalo in un luogo sicuro. Ti servirà se perdi l’accesso alla tua chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全な場所に保管してください。鍵へのアクセスを失った場合に必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "안전한 곳에 보관하세요. 키에 대한 액세스 권한을 잃을 경우 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarde-o num local seguro. Vai precisar dele se perder o acesso à sua chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Храните его в надёжном месте. Он понадобится, если вы потеряете доступ к своему ключу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请妥善保管。如果您失去对密钥的访问权限，将会需要它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請妥善保管。如果您失去對金鑰的存取權限，將會需要它。"
