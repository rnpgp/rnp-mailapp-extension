    "rotate.encryption.message": {
      "comment": "Rotation explanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new encryption subkey will be generated and the old one retired after a 30-day grace period."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein neuer Verschlüsselungs-Unterschlüssel wird erzeugt und der alte nach einer 30-tägigen Übergangsfrist außer Dienst gestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se generará una nueva subclave de cifrado y la anterior se retirará tras un período de gracia de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une nouvelle sous-clé de chiffrement sera générée et l’ancienne sera retirée après une période de grâce de 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verrà generata una nuova sottochiave di crittografia e quella precedente verrà ritirata dopo un periodo di grazia di 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しい暗号化副鍵が生成され、古い副鍵は 30 日間の猶予期間後に廃止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 암호화 하위 키가 생성되고 기존 키는 30일 유예 기간 후에 사용 중지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma nova subchave de encriptação será gerada e a antiga será retirada após um período de tolerância de 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
