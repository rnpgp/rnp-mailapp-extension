    "detail.exportSecret.message": {
      "comment": "Secret export warning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secret key will be exported as an armored, passphrase-protected block. Keep it safe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der geheime Schlüssel wird als armorierter, durch eine Passphrase geschützter Block exportiert. Bewahren Sie ihn sicher auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clave secreta se exportará como un bloque blindado protegido por una frase de contraseña. Guárdala en un lugar seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clé secrète sera exportée sous forme de bloc avec armure ASCII protégé par une phrase de passe. Conservez-la en lieu sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La chiave segreta verrà esportata come blocco con armatura ASCII protetto da passphrase. Conservala in un luogo sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "秘密鍵はパスフレーズで保護されたアーマードブロックとしてエクスポートされます。安全に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "비밀 키는 암호로 보호된 아머드 블록으로 내보내집니다. 안전하게 보관하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A chave secreta será exportada como um bloco blindado protegido por frase-passe. Guarde-a em segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Секретный ключ будет экспортирован в виде блока ASCII Armor, защищённого парольной фразой. Храните его в безопасном месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "私钥将以受密码短语保护的 ASCII 装甲块形式导出。请妥善保管。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "私鑰將以受密碼短語保護的 ASCII 盔甲區塊形式匯出。請妥善保管。"
          }
        }
      }
    },
