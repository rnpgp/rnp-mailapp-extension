    "banner.trustConflict": {
      "comment": "Trust conflict banner with email.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key changed for %@. Verify the new fingerprint before encrypting."
          }
        },
        "de": {
          "stringUnit": {
