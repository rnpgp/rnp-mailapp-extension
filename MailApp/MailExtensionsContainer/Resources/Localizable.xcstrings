    "revoke.message": {
      "comment": "Revoke instructions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the full fingerprint of the key to revoke it. A revocation certificate will be saved to the keyring directory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geben Sie den vollständigen Fingerabdruck des Schlüssels ein, um ihn zu widerrufen. Ein Widerrufszertifikat wird im Schlüsselring-Verzeichnis gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe la huella completa de la clave para revocarla. Se guardará un certificado de revocación en el directorio del llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez l’empreinte complète de la clé pour la révoquer. Un certificat de révocation sera enregistré dans le répertoire du trousseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digita l’impronta digitale completa della chiave per revocarla. Un certificato di revoca verrà salvato nella directory del portachiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "失効する鍵の完全なフィンガープリントを入力してください。失効証明書がキーリングのディレクトリに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폐기할 키의 전체 지문을 입력하세요. 폐기 인증서가 키링 디렉터리에 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite a impressão digital completa da chave para a revogar. Um certificado de revogação será guardado no diretório do porta-chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введите полный отпечаток ключа, чтобы отозвать его. Сертификат отзыва будет сохранён в каталоге связки ключей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入要吊销密钥的完整指纹。吊销证书将保存到密钥环目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入要撤銷金鑰的完整指紋。撤銷憑證將儲存到金鑰環目錄。"
          }
        }
      }
    },
