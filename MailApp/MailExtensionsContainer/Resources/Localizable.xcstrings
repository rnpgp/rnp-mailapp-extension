    "detail.delete.message": {
      "comment": "Delete confirmation message.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the key from the shared keyring. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Schlüssel wird aus dem gemeinsamen Schlüsselring entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina la clave del llavero compartido. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clé sera supprimée du trousseau partagé. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La chiave verrà rimossa dal portachiavi condiviso. Questa operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "共有キーリングから鍵が削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "공유 키링에서 키가 제거됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isto remove a chave do porta-chaves partilhado. Esta ação não pode ser anulada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключ будет удалён из общей связки ключей. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这将从共享密钥环中移除该密钥。此操作无法撤销。"
