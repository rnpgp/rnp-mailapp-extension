    "keyservers.message": {
      "comment": "Explanation of the keyserver priority list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are looked up on these servers in order. If one fails, the next is tried. Custom HKPS servers can be added below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schlüssel werden auf diesen Servern in der angegebenen Reihenfolge gesucht. Schlägt einer fehl, wird der nächste versucht. Eigene HKPS-Server können unten hinzugefügt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las claves se buscan en estos servidores en orden. Si uno falla, se prueba el siguiente. Abajo se pueden añadir servidores HKPS personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les clés sont recherchées sur ces serveurs dans l'ordre. Si l'un échoue, le suivant est essayé. Des serveurs HKPS personnalisés peuvent être ajoutés ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le chiavi vengono cercate su questi server in ordine. Se uno fallisce, si prova il successivo. Server HKPS personalizzati possono essere aggiunti qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "鍵はこれらのサーバーに順番に照会されます。失敗した場合は次のサーバーが試されます。カスタムHKPSサーバーは下で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키는 이 서버들에서 순서대로 조회됩니다. 하나가 실패하면 다음 서버를 시도합니다. 사용자 지정 HKPS 서버는 아래에서 추가할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As chaves são procuradas nestes servidores por ordem. Se um falhar, é tentado o seguinte. Servidores HKPS personalizados podem ser adicionados abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключи ищутся на этих серверах по порядку. Если один не отвечает, пробуется следующий. Пользовательские HKPS-серверы можно добавить ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按顺序在这些服务器上查找密钥。如果某个服务器失败，则尝试下一个。可在下方添加自定义 HKPS 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按順序在這些伺服器上查找金鑰。如果某個伺服器失敗，則嘗試下一個。可在下方加入自訂 HKPS 伺服器。"
          }
        }
      }
    },
